fmod FOO1 is
  including BOOL .
  protecting NAT .
  op f : Nat -> Nat .
  eq f(0) = 1 .
  eq f(s X:Nat) = s X:Nat * f(X:Nat) [print "X = " X:Nat] .
endfm
